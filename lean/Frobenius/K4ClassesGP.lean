  have C : Cert ((40 * (t + 1) + 0) ^ 4) (((40 * (t + 1) + 0) + 1) ^ 4) (((40 * (t + 1) + 0) + 2) ^ 4) ((2560 * t ^ 2 + 5504 * t + 2960) + (640 * t ^ 2 + 1216 * t + 575) + 1) ((2600 * t ^ 2 + 5300 * t + 2701) + (280 * t ^ 2 + 564 * t + 283) + 1) (2560 * t ^ 2 + 5504 * t + 2960) (2600 * t ^ 2 + 5300 * t + 2701) (600 * t ^ 2 + 1220 * t + 620) (320 * t ^ 2 + 680 * t + 361) :=
    ⟨by positivity, Nat.Coprime.pow 4 4 (by simp), by omega, by omega, by ring, by ring, by ring,
      by positivity, by positivity⟩
  have hb : 0 < ((40 * (t + 1) + 0) + 1) ^ 4 := by positivity
  have hc : 0 < ((40 * (t + 1) + 0) + 2) ^ 4 := by positivity
  have hw1 : 1 ≤ (2560 * t ^ 2 + 5504 * t + 2960) := Nat.succ_le_of_lt (by positivity)
  have hy1 : 1 ≤ (2600 * t ^ 2 + 5300 * t + 2701) := Nat.succ_le_of_lt (by positivity)
  have h1 : (8908800000 * t ^ 6 + 55244800000 * t ^ 5 + 142750720000 * t ^ 4 + 196738304000 * t ^ 3 + 152526761600 * t ^ 2 + 63070292704 * t + 10867115103) + (40 * (t + 1) + 0) ^ 4 = ((2560 * t ^ 2 + 5504 * t + 2960) + (640 * t ^ 2 + 1216 * t + 575)) * ((40 * (t + 1) + 0) + 1) ^ 4 + (280 * t ^ 2 + 564 * t + 283) * ((40 * (t + 1) + 0) + 2) ^ 4 := by ring
  have h2 : (9011200000 * t ^ 6 + 55808000000 * t ^ 5 + 144020480000 * t ^ 4 + 198232832000 * t ^ 3 + 153487776000 * t ^ 2 + 63386177440 * t + 10907553439) + (40 * (t + 1) + 0) ^ 4 = (640 * t ^ 2 + 1216 * t + 575) * ((40 * (t + 1) + 0) + 1) ^ 4 + ((2600 * t ^ 2 + 5300 * t + 2701) + (280 * t ^ 2 + 564 * t + 283)) * ((40 * (t + 1) + 0) + 2) ^ 4 := by ring
  have hmod : (40 * (t + 1) + 0) % 40 = 0 := by omega
  refine ⟨?_, ?_, type_uv C hb hc hw1 hy1 h1 h2⟩
  · have hg := genus_uv C
    have hR : (4720640000 * t ^ 6 + 29236736000 * t ^ 5 + 75451302400 * t ^ 4 + 103854184960 * t ^ 3 + 80412581120 * t ^ 2 + 33207977680 * t + 5714375120) * (40 * (t + 1) + 0) ^ 4 * 2 + (40 * (t + 1) + 0) ^ 4 * (40 * (t + 1) + 0) ^ 4 + (2560 * t ^ 2 + 5504 * t + 2960) * (2600 * t ^ 2 + 5300 * t + 2701) * (((2560 * t ^ 2 + 5504 * t + 2960) + 2 * (640 * t ^ 2 + 1216 * t + 575) + 1) * ((40 * (t + 1) + 0) + 1) ^ 4 + ((2600 * t ^ 2 + 5300 * t + 2701) + 2 * (280 * t ^ 2 + 564 * t + 283) + 1) * ((40 * (t + 1) + 0) + 2) ^ 4)
        = ((2560 * t ^ 2 + 5504 * t + 2960) + (640 * t ^ 2 + 1216 * t + 575) + 1) * ((2600 * t ^ 2 + 5300 * t + 2701) + (280 * t ^ 2 + 564 * t + 283) + 1) * (((2560 * t ^ 2 + 5504 * t + 2960) + (640 * t ^ 2 + 1216 * t + 575)) * ((40 * (t + 1) + 0) + 1) ^ 4 + ((2600 * t ^ 2 + 5300 * t + 2701) + (280 * t ^ 2 + 564 * t + 283)) * ((40 * (t + 1) + 0) + 2) ^ 4) + (40 * (t + 1) + 0) ^ 4 := by ring
    have hG : genus {(40 * (t + 1) + 0) ^ 4, ((40 * (t + 1) + 0) + 1) ^ 4, ((40 * (t + 1) + 0) + 2) ^ 4} = (4720640000 * t ^ 6 + 29236736000 * t ^ 5 + 75451302400 * t ^ 4 + 103854184960 * t ^ 3 + 80412581120 * t ^ 2 + 33207977680 * t + 5714375120) := by
      have hpos : 0 < (40 * (t + 1) + 0) ^ 4 * 2 := by positivity
      apply Nat.eq_of_mul_eq_mul_right hpos
      have e1 : genus {(40 * (t + 1) + 0) ^ 4, ((40 * (t + 1) + 0) + 1) ^ 4, ((40 * (t + 1) + 0) + 2) ^ 4} * ((40 * (t + 1) + 0) ^ 4 * 2) = genus {(40 * (t + 1) + 0) ^ 4, ((40 * (t + 1) + 0) + 1) ^ 4, ((40 * (t + 1) + 0) + 2) ^ 4} * (40 * (t + 1) + 0) ^ 4 * 2 := by ring
      have e2 : (4720640000 * t ^ 6 + 29236736000 * t ^ 5 + 75451302400 * t ^ 4 + 103854184960 * t ^ 3 + 80412581120 * t ^ 2 + 33207977680 * t + 5714375120) * ((40 * (t + 1) + 0) ^ 4 * 2) = (4720640000 * t ^ 6 + 29236736000 * t ^ 5 + 75451302400 * t ^ 4 + 103854184960 * t ^ 3 + 80412581120 * t ^ 2 + 33207977680 * t + 5714375120) * (40 * (t + 1) + 0) ^ 4 * 2 := by ring
      rw [e1, e2]; omega
    rw [hG, Gam_eq_0 _ hmod]; unfold gam0
    exact Int.eq_ediv_of_mul_eq_right (by norm_num) (by push_cast; ring)
  · intro x
