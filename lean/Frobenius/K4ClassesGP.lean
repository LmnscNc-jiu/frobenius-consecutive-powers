    have e2 : (((9011200000 * t ^ 6 + 55808000000 * t ^ 5 + 144020480000 * t ^ 4 + 198232832000 * t ^ 3 + 153487776000 * t ^ 2 + 63386177440 * t + 10907553439) : ℕ) : ℤ) = PFb (40 * (t + 1) + 0) := by
      rw [PFb_eq_0 _ hmod]; unfold pfb0
      exact Int.eq_ediv_of_mul_eq_right (by norm_num) (by push_cast; ring)
