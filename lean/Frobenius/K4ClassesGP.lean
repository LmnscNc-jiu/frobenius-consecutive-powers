/-- Genus, pseudo-Frobenius numbers and type for `n ≡ 0 (mod 40)`, `n ≥ 40`. -/
theorem classGP_0 (t : ℕ) :
    (genus {(40 * (t + 1) + 0) ^ 4, ((40 * (t + 1) + 0) + 1) ^ 4, ((40 * (t + 1) + 0) + 2) ^ 4} : ℤ) = Gam (40 * (t + 1) + 0) ∧
