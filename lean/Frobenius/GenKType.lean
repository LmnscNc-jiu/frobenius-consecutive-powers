import Frobenius.GenKGrowth

/-!
# Corollary 1.3: embedding dimension three, non-symmetry and type two

For `k ≥ 2` and `n ≥ 2^{k+1}`:
* none of the three generators of `S_n^k` lies in the semigroup generated by the other two
  (`emb_dim_three`);
* every L-shaped certificate of `S_n^k` has `w ≥ 1` and `y ≥ 1` (`cert_w_pos`, `cert_y_pos`);
* hence `S_n^k` has exactly two pseudo-Frobenius numbers (`type_two`, `pf_two`) and is not
  symmetric (`not_symmetric`);
* for odd `n` the bound `n > 2^k` suffices (`type_two_odd`, `not_symmetric_odd`).

The proof does not use Herzog's theorem: the L-shape (`FrobCert.exists_cert`) together with the
certificate criterion describes the pseudo-Frobenius numbers directly, and the degenerate
L-shapes (`w = 0` or `y = 0`) are excluded by elementary congruences.
-/

open FrobCert

namespace GenK

theorem mem_closure_pair (p q x : ℕ) :
    x ∈ AddSubmonoid.closure ({p, q} : Set ℕ) ↔ ∃ i j : ℕ, x = i * p + j * q := by
  have hs : ({p, q} : Set ℕ) = {p, p, q} := by
    rw [Set.insert_eq_of_mem (Set.mem_insert p _)]
  rw [hs, mem_closure_iff]
  constructor
  · rintro ⟨α, i, j, rfl⟩; exact ⟨α + i, j, by ring⟩
  · rintro ⟨i, j, rfl⟩; exact ⟨i, 0, j, by ring⟩

/-! ### Embedding dimension -/

theorem c_lt_two_pow_mul_b (k n : ℕ) (hk : k ≠ 0) (hn : 1 ≤ n) :
    (n + 2) ^ k < 2 ^ k * (n + 1) ^ k := by
  rw [← mul_pow]; exact Nat.pow_lt_pow_left (by omega) hk

/-- `(n+2)^k ∉ ⟨n^k, (n+1)^k⟩` for `n > 2^k`. -/
theorem c_not_mem {k n : ℕ} (hk : 1 ≤ k) (hn : 2 ^ k < n) :
    (n + 2) ^ k ∉ AddSubmonoid.closure ({n ^ k, (n + 1) ^ k} : Set ℕ) := by
  rw [mem_closure_pair]
  rintro ⟨x, y, hxy⟩
  have hk0 : k ≠ 0 := by omega
  -- y < 2^k
  have hy : y < 2 ^ k := by
    by_contra hcon; push Not at hcon
    have h1 : 2 ^ k * (n + 1) ^ k ≤ y * (n + 1) ^ k := Nat.mul_le_mul_right _ hcon
    have h2k : 0 < 2 ^ k := by positivity
    have h2 := c_lt_two_pow_mul_b k n hk0 (by omega)
    omega
  -- y ≡ 2^k (mod n)
  have m1 : (n + 2) ^ k ≡ 2 ^ k [MOD n] := Nat.ModEq.pow k (by simp [Nat.ModEq, Nat.add_mod_left])
  have m2 : x * n ^ k + y * (n + 1) ^ k ≡ x * 0 + y * 1 [MOD n] := by
    refine Nat.ModEq.add (Nat.ModEq.mul_left _ ?_) (Nat.ModEq.mul_left _ ?_)
    · exact Nat.modEq_zero_iff_dvd.mpr (dvd_pow_self n hk0)
    · have : n + 1 ≡ 1 [MOD n] := by simp [Nat.ModEq, Nat.add_mod_left]
      simpa using this.pow k
  rw [← hxy] at m2
  have m3 : y ≡ 2 ^ k [MOD n] := by simpa using m2.symm.trans m1
  have : y = 2 ^ k := by
    unfold Nat.ModEq at m3
    rwa [Nat.mod_eq_of_lt (by omega), Nat.mod_eq_of_lt hn] at m3
  omega

/-- `(n+1)^k ∉ ⟨n^k, (n+2)^k⟩` for `n ≥ 2`. -/
theorem b_not_mem {k n : ℕ} (hk : 1 ≤ k) (hn : 2 ≤ n) :
    (n + 1) ^ k ∉ AddSubmonoid.closure ({n ^ k, (n + 2) ^ k} : Set ℕ) := by
  rw [mem_closure_pair]
  rintro ⟨x, y, hxy⟩
  have hbc := b_lt_c (n := n) hk
  rcases Nat.eq_zero_or_pos y with hy | hy
  · subst hy
    have hdvd : n ^ k ∣ (n + 1) ^ k := ⟨x, by rw [hxy]; ring⟩
    have h1 := Nat.Coprime.eq_one_of_dvd (coprime_ab k n) hdvd
    have := two_le_a hk hn
    omega
  · have : (n + 2) ^ k ≤ y * (n + 2) ^ k := Nat.le_mul_of_pos_left _ hy
    omega

/-- `n^k ∉ ⟨(n+1)^k, (n+2)^k⟩` for `n ≥ 1`. -/
theorem a_not_mem {k n : ℕ} (hk : 1 ≤ k) (hn : 1 ≤ n) :
    n ^ k ∉ AddSubmonoid.closure ({(n + 1) ^ k, (n + 2) ^ k} : Set ℕ) := by
  rw [mem_closure_pair]
  rintro ⟨x, y, hxy⟩
  have hab := a_lt_b (n := n) hk
  have hbc := b_lt_c (n := n) hk
  have hpos : 0 < n ^ k := by positivity
  rcases Nat.eq_zero_or_pos x with hx | hx
  · rcases Nat.eq_zero_or_pos y with hy | hy
    · subst hx hy; simp at hxy; omega
    · have : (n + 2) ^ k ≤ y * (n + 2) ^ k := Nat.le_mul_of_pos_left _ hy
      omega
  · have : (n + 1) ^ k ≤ x * (n + 1) ^ k := Nat.le_mul_of_pos_left _ hx
    omega

/-- **Corollary 1.3 (embedding dimension three).** -/
theorem emb_dim_three {k n : ℕ} (hk : 1 ≤ k) (hn : 2 ^ k < n) :
    n ^ k ∉ AddSubmonoid.closure ({(n + 1) ^ k, (n + 2) ^ k} : Set ℕ) ∧
    (n + 1) ^ k ∉ AddSubmonoid.closure ({n ^ k, (n + 2) ^ k} : Set ℕ) ∧
    (n + 2) ^ k ∉ AddSubmonoid.closure ({n ^ k, (n + 1) ^ k} : Set ℕ) := by
  have h2 : 2 ≤ 2 ^ k := by
    calc 2 = 2 ^ 1 := rfl
      _ ≤ 2 ^ k := Nat.pow_le_pow_right (by omega) hk
  exact ⟨a_not_mem hk (by omega), b_not_mem hk (by omega), c_not_mem hk hn⟩

/-! ### Non-degeneracy of the L-shape -/

/-- `(1 + t m)^k ≡ 1 + k t m (mod m²)`. -/
theorem one_add_pow_modEq (m t : ℤ) : ∀ k : ℕ, m ^ 2 ∣ (1 + t * m) ^ k - (1 + k * t * m)
  | 0 => by simp
  | k + 1 => by
      obtain ⟨r, hr⟩ := one_add_pow_modEq m t k
      refine ⟨(1 + t * m) * r + k * t ^ 2, ?_⟩
      have e : (1 + t * m) ^ (k + 1) = (1 + t * m) * ((1 + t * m) ^ k) := by ring
      rw [e, show (1 + t * m) ^ k = (1 + k * t * m) + m ^ 2 * r by linear_combination hr]
      push_cast; ring

/-- The key congruence argument for even `n = 2m`: `y (m+1)^k + q m^k = (2m+1)^k` is impossible
for `m ≥ 2^k`, `k ≥ 2`. -/
theorem no_ci_relation {k m y q : ℕ} (hk : 2 ≤ k) (hm : 2 ^ k ≤ m)
    (h : y * (m + 1) ^ k + q * m ^ k = (2 * m + 1) ^ k) : False := by
  have hk0 : k ≠ 0 := by omega
  have hk2 : k < 2 ^ k := Nat.lt_two_pow_self
  have hm4 : 4 ≤ m := by
    have : 2 ^ 2 ≤ 2 ^ k := Nat.pow_le_pow_right (by omega) hk
    omega
  -- y < 2^k
  have hy : y < 2 ^ k := by
    by_contra hcon; push Not at hcon
    have h1 : 2 ^ k * (m + 1) ^ k ≤ y * (m + 1) ^ k := Nat.mul_le_mul_right _ hcon
    have h2 : (2 * m + 1) ^ k < 2 ^ k * (m + 1) ^ k := by
      rw [← mul_pow]; exact Nat.pow_lt_pow_left (by omega) hk0
    omega
  -- y ≡ 1 (mod m)
  have m1 : y * (m + 1) ^ k + q * m ^ k ≡ y * 1 + q * 0 [MOD m] := by
    refine Nat.ModEq.add (Nat.ModEq.mul_left _ ?_) (Nat.ModEq.mul_left _ ?_)
    · have : m + 1 ≡ 1 [MOD m] := by simp [Nat.ModEq, Nat.add_mod_left]
      simpa using this.pow k
    · exact Nat.modEq_zero_iff_dvd.mpr (dvd_pow_self m hk0)
  have m2 : (2 * m + 1) ^ k ≡ 1 [MOD m] := by
    have : 2 * m + 1 ≡ 1 [MOD m] := by simp [Nat.ModEq]
    simpa using this.pow k
  rw [h] at m1
  have m3 : y ≡ 1 [MOD m] := by simpa using m1.symm.trans m2
  have hy1 : y = 1 := by
    unfold Nat.ModEq at m3
    rwa [Nat.mod_eq_of_lt (by omega), Nat.mod_eq_of_lt (by omega)] at m3
  subst hy1
  -- modulo m²
  have hz : ((m + 1 : ℕ) : ℤ) ^ k + (q : ℤ) * (m : ℤ) ^ k = ((2 * m + 1 : ℕ) : ℤ) ^ k := by
    exact_mod_cast (by simpa using h)
  have d1 := one_add_pow_modEq (m : ℤ) 1 k
  have d2 := one_add_pow_modEq (m : ℤ) 2 k
  have d3 : (m : ℤ) ^ 2 ∣ (q : ℤ) * (m : ℤ) ^ k :=
    dvd_mul_of_dvd_right (pow_dvd_pow _ hk) _
  have hkm : (m : ℤ) ^ 2 ∣ (k : ℤ) * m := by
    have e : (k : ℤ) * m = ((1 + 1 * (m : ℤ)) ^ k - (1 + k * 1 * m)) + (q : ℤ) * (m : ℤ) ^ k -
        ((1 + 2 * (m : ℤ)) ^ k - (1 + k * 2 * m)) := by
      push_cast at hz
      linear_combination (-1 : ℤ) * hz
    rw [e]; exact dvd_sub (dvd_add d1 d3) d2
  have hmk : (m : ℤ) ∣ k := by
    have hm0 : (m : ℤ) ≠ 0 := by positivity
    rw [pow_two] at hkm
    exact (mul_dvd_mul_iff_right hm0).mp (by simpa [mul_comm] using hkm)
  have := Nat.le_of_dvd (by omega) (Int.natCast_dvd_natCast.mp hmk)
  omega

variable {k n l h w y q₁ q₂ : ℕ}

/-- `y ≥ 1` in every certificate of `S_n^k` (`n > 2^k`). -/
theorem cert_y_pos (hk : 1 ≤ k) (hn : 2 ^ k < n)
    (C : Cert (n ^ k) ((n + 1) ^ k) ((n + 2) ^ k) l h w y q₁ q₂) : 1 ≤ y := by
  by_contra hy0
  have hy : y = 0 := by omega
  have hdet := C.det
  have r1 := C.rel₁
  have r2 := C.rel₂
  rw [hy] at hdet r1
  simp only [Nat.mul_zero, Nat.add_zero, Nat.zero_mul, Nat.zero_add] at hdet r1
  -- a ∣ l b, so a ∣ l, so l = a and h = 1
  have hdvd : n ^ k ∣ l * (n + 1) ^ k := ⟨q₁, r1.symm⟩
  have hal : n ^ k ∣ l := (coprime_ab k n).dvd_of_dvd_mul_right hdvd
  have hl1 : 1 ≤ l := by have := C.hw; omega
  have hle := Nat.le_of_dvd hl1 hal
  have h2k : 0 < 2 ^ k := by positivity
  have hpos : 0 < n ^ k := pow_pos (by omega) _
  have hh1 : h = 1 := by
    have hlh : l * h = n ^ k := hdet
    rcases Nat.lt_or_ge h 2 with h2 | h2
    · have := C.hy; omega
    · have : l * 2 ≤ l * h := Nat.mul_le_mul_left _ h2
      omega
  rw [hh1, one_mul] at r2
  apply c_not_mem hk hn
  rw [mem_closure_pair]
  exact ⟨q₂, w, by rw [← r2]; ring⟩

/-- `w ≥ 1` in every certificate of `S_n^k` (`k ≥ 2`, `n > 2^k`, and `n ≥ 2^{k+1}` if `n` is
even). -/
theorem cert_w_pos (hk : 2 ≤ k) (hn' : 2 ^ k < n) (hev : Even n → 2 ^ (k + 1) ≤ n)
    (C : Cert (n ^ k) ((n + 1) ^ k) ((n + 2) ^ k) l h w y q₁ q₂) : 1 ≤ w := by
  by_contra hw0
  have hw : w = 0 := by omega
  have hk1 : 1 ≤ k := by omega
  have hdet := C.det
  have r1 := C.rel₁
  have r2 := C.rel₂
  rw [hw] at hdet r2
  simp only [Nat.zero_mul, Nat.zero_add, Nat.add_zero] at hdet r2
  have hh1 : 1 ≤ h := by have := C.hy; omega
  have hpow : 2 ≤ 2 ^ k := by
    calc 2 = 2 ^ 1 := rfl
      _ ≤ 2 ^ k := Nat.pow_le_pow_right (by omega) hk1
  have hn2 : 2 ≤ n := by omega
  -- l q₂ = c, so l ∣ c; l ∣ a
  have hlc : l * q₂ = (n + 2) ^ k := by
    have : h * (l * q₂) = h * (n + 2) ^ k := by
      rw [← hdet] at r2; rw [← r2]; ring
    exact Nat.eq_of_mul_eq_mul_left (by omega) this
  have hla : l ∣ n ^ k := ⟨h, hdet.symm⟩
  have hlc' : l ∣ (n + 2) ^ k := ⟨q₂, hlc.symm⟩
  rcases Nat.even_or_odd n with ⟨m, hm⟩ | hodd
  · -- n = 2m
    have hn : 2 ^ (k + 1) ≤ n := hev ⟨m, hm⟩
    have hnm : n = 2 * m := by omega
    subst hnm
    have hmk : 2 ^ k ≤ m := by
      have : 2 ^ (k + 1) = 2 * 2 ^ k := by ring
      omega
    have ea : (2 * m) ^ k = 2 ^ k * m ^ k := mul_pow _ _ _
    have ec : (2 * m + 2) ^ k = 2 ^ k * (m + 1) ^ k := by rw [← mul_pow]; ring_nf
    -- 2^k ∣ l
    have h2l : 2 ^ k ∣ l := by
      have hdv : 2 ^ k ∣ l * (2 * m + 1) ^ k := by
        rw [← r1, ea, ec]
        exact dvd_add (dvd_mul_of_dvd_right (dvd_mul_right _ _) _)
          (dvd_mul_of_dvd_left (dvd_mul_right _ _) _)
      have cop : Nat.Coprime (2 ^ k) ((2 * m + 1) ^ k) := by
        apply Nat.Coprime.pow
        have := (Nat.coprime_mul_right_add_right 2 1 m).mpr (Nat.coprime_one_right 2)
        rwa [mul_comm] at this
      exact cop.dvd_of_dvd_mul_right hdv
    obtain ⟨t, rfl⟩ := h2l
    have hpos : 0 < 2 ^ k := by positivity
    have ht1 : t = 1 := by
      have h1 : t ∣ m ^ k := Nat.dvd_of_mul_dvd_mul_left hpos (by rw [← ea]; exact hla)
      have h2 : t ∣ (m + 1) ^ k := Nat.dvd_of_mul_dvd_mul_left hpos (by rw [← ec]; exact hlc')
      exact Nat.Coprime.eq_one_of_dvd (Nat.Coprime.pow _ _
        (Nat.coprime_self_add_right.mpr (Nat.coprime_one_right m)) |>.coprime_dvd_left h1) h2
    subst ht1
    rw [ea, ec, mul_one] at r1
    have r1' : 2 ^ k * (y * (m + 1) ^ k + q₁ * m ^ k) = 2 ^ k * (2 * m + 1) ^ k := by
      rw [← r1]; ring
    exact no_ci_relation hk hmk (Nat.eq_of_mul_eq_mul_left hpos r1')
  · -- n odd: gcd(a, c) = 1, so l = 1, then a ∣ b
    have cop : Nat.Coprime (n ^ k) ((n + 2) ^ k) := by
      apply Nat.Coprime.pow
      apply Nat.coprime_self_add_right.mpr
      obtain ⟨r, hr⟩ := hodd
      rw [hr]
      have := (Nat.coprime_mul_right_add_right 2 1 r).mpr (Nat.coprime_one_right 2)
      rw [mul_comm] at this
      exact this.symm
    have hl : l = 1 := Nat.eq_one_of_dvd_coprimes cop hla hlc'
    subst hl
    have hbc := b_lt_c (n := n) hk1
    rcases Nat.eq_zero_or_pos y with hy | hy
    · rw [hy] at r1
      simp only [Nat.zero_mul, Nat.zero_add, one_mul] at r1
      have := Nat.Coprime.eq_one_of_dvd (coprime_ab k n) ⟨q₁, r1.symm⟩
      have := two_le_a hk1 hn2
      omega
    · have : (n + 2) ^ k ≤ y * (n + 2) ^ k := Nat.le_mul_of_pos_left _ hy
      omega

/-! ### Type two and non-symmetry -/

/-- For `k ≥ 2`, `n > 2^k`, and `n ≥ 2^{k+1}` if `n` is even, there is an L-shaped certificate
with `w, y ≥ 1`, and the pseudo-Frobenius numbers of `S_n^k` are exactly
`F₁ = (l-1) b + (h-y-1) c - a` and `F₂ = (l-w-1) b + (h-1) c - a`. -/
theorem pf_two_of (hk : 2 ≤ k) (hn' : 2 ^ k < n) (hev : Even n → 2 ^ (k + 1) ≤ n) :
    ∃ l h w y q₁ q₂, Cert (n ^ k) ((n + 1) ^ k) ((n + 2) ^ k) l h w y q₁ q₂ ∧ 1 ≤ w ∧ 1 ≤ y ∧
      ∀ x, IsPF (gensK k n) x ↔
        (x + n ^ k = (l - 1) * (n + 1) ^ k + (h - y - 1) * (n + 2) ^ k ∨
         x + n ^ k = (l - w - 1) * (n + 1) ^ k + (h - 1) * (n + 2) ^ k) := by
  have hk1 : 1 ≤ k := by omega
  have h2k : 0 < 2 ^ k := by positivity
  obtain ⟨l, h, w, y, q₁, q₂, C⟩ := cert_k hk1 (by omega : 1 ≤ n)
  have hw1 := cert_w_pos hk hn' hev C
  have hy1 := cert_y_pos hk1 hn' C
  refine ⟨l, h, w, y, q₁, q₂, C, hw1, hy1, fun x => ?_⟩
  have hb : 0 < (n + 1) ^ k := by positivity
  have hc : 0 < (n + 2) ^ k := by positivity
  rw [isPF_iff C hb hc]
  constructor
  · rintro ⟨i, j, hM, hx⟩
    rcases (isMax_iff C.hw C.hy hw1 hy1).mp hM with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact Or.inl hx
    · exact Or.inr hx
  · rintro (hx | hx)
    · exact ⟨_, _, (isMax_iff C.hw C.hy hw1 hy1).mpr (Or.inl ⟨rfl, rfl⟩), hx⟩
    · exact ⟨_, _, (isMax_iff C.hw C.hy hw1 hy1).mpr (Or.inr ⟨rfl, rfl⟩), hx⟩

/-- Type two under the hypotheses of `pf_two_of`. -/
theorem type_two_of (hk : 2 ≤ k) (hn' : 2 ^ k < n) (hev : Even n → 2 ^ (k + 1) ≤ n) :
    Set.ncard {x | IsPF (gensK k n) x} = 2 := by
  have hk1 : 1 ≤ k := by omega
  have h2k : 0 < 2 ^ k := by positivity
  obtain ⟨l, h, w, y, q₁, q₂, C⟩ := cert_k hk1 (by omega : 1 ≤ n)
  have hw1 := cert_w_pos hk hn' hev C
  have hy1 := cert_y_pos hk1 hn' C
  have hwl := C.hw
  have hyh := C.hy
  obtain ⟨u, rfl⟩ : ∃ u, l = w + u + 1 := ⟨l - w - 1, by omega⟩
  obtain ⟨v, rfl⟩ : ∃ v, h = y + v + 1 := ⟨h - y - 1, by omega⟩
  have hab := a_lt_b (n := n) hk1
  have hb : 0 < (n + 1) ^ k := by positivity
  have hc : 0 < (n + 2) ^ k := by positivity
  have hP1 : n ^ k ≤ (w + u) * (n + 1) ^ k + v * (n + 2) ^ k := by
    have : (n + 1) ^ k ≤ (w + u) * (n + 1) ^ k := Nat.le_mul_of_pos_left _ (by omega)
    omega
  have hP2 : n ^ k ≤ u * (n + 1) ^ k + (y + v) * (n + 2) ^ k := by
    have hbc := b_lt_c (n := n) hk1
    have : (n + 2) ^ k ≤ (y + v) * (n + 2) ^ k := Nat.le_mul_of_pos_left _ (by omega)
    omega
  exact type_uv C hb hc hw1 hy1 (Nat.sub_add_cancel hP1) (Nat.sub_add_cancel hP2)

/-- The Frobenius number is a pseudo-Frobenius number. -/
theorem isPF_frob {s : Set ℕ} {F : ℕ} (hF : FrobeniusNumber F s) : IsPF s F := by
  refine ⟨hF.1, fun z _ hz0 => ?_⟩
  by_contra hcon
  have := hF.2 hcon
  omega

/-- Non-symmetry under the hypotheses of `pf_two_of`: there is `x ≤ F` with `x ∉ S_n^k` and
`F - x ∉ S_n^k`. -/
theorem not_symmetric_of (hk : 2 ≤ k) (hn' : 2 ^ k < n) (hev : Even n → 2 ^ (k + 1) ≤ n)
    {F : ℕ} (hF : FrobeniusNumber F (gensK k n)) :
    ∃ x ≤ F, x ∉ AddSubmonoid.closure (gensK k n) ∧ F - x ∉ AddSubmonoid.closure (gensK k n) := by
  obtain ⟨p, q, hpq, hset⟩ := Set.ncard_eq_two.mp (type_two_of hk hn' hev)
  -- one of the two pseudo-Frobenius numbers differs from F
  obtain ⟨x, hxPF, hxF⟩ : ∃ x, IsPF (gensK k n) x ∧ x ≠ F := by
    have hp : IsPF (gensK k n) p := by
      have : p ∈ ({p, q} : Set ℕ) := Set.mem_insert _ _
      rw [← hset] at this; exact this
    have hq : IsPF (gensK k n) q := by
      have : q ∈ ({p, q} : Set ℕ) := Set.mem_insert_of_mem _ rfl
      rw [← hset] at this; exact this
    by_cases hpF : p = F
    · exact ⟨q, hq, fun h => hpq (hpF.trans h.symm)⟩
    · exact ⟨p, hp, hpF⟩
  have hxle : x ≤ F := hF.2 hxPF.1
  refine ⟨x, hxle, hxPF.1, fun hFx => hF.1 ?_⟩
  have := hxPF.2 (F - x) hFx (by omega)
  rwa [Nat.add_sub_cancel' hxle] at this

theorem large_cond {k n : ℕ} (hn : 2 ^ (k + 1) ≤ n) : 2 ^ k < n := by
  have : 2 ^ (k + 1) = 2 * 2 ^ k := by ring
  have : 0 < 2 ^ k := by positivity
  omega

/-- **Corollary 1.3 (pseudo-Frobenius numbers)**, `n ≥ 2^{k+1}`. -/
theorem pf_two (hk : 2 ≤ k) (hn : 2 ^ (k + 1) ≤ n) :
    ∃ l h w y q₁ q₂, Cert (n ^ k) ((n + 1) ^ k) ((n + 2) ^ k) l h w y q₁ q₂ ∧ 1 ≤ w ∧ 1 ≤ y ∧
      ∀ x, IsPF (gensK k n) x ↔
        (x + n ^ k = (l - 1) * (n + 1) ^ k + (h - y - 1) * (n + 2) ^ k ∨
         x + n ^ k = (l - w - 1) * (n + 1) ^ k + (h - 1) * (n + 2) ^ k) :=
  pf_two_of hk (large_cond hn) (fun _ => hn)

/-- **Corollary 1.3 (type two)**, `n ≥ 2^{k+1}`. -/
theorem type_two (hk : 2 ≤ k) (hn : 2 ^ (k + 1) ≤ n) : Set.ncard {x | IsPF (gensK k n) x} = 2 :=
  type_two_of hk (large_cond hn) (fun _ => hn)

/-- **Corollary 1.3 (non-symmetry)**, `n ≥ 2^{k+1}`. -/
theorem not_symmetric (hk : 2 ≤ k) (hn : 2 ^ (k + 1) ≤ n) {F : ℕ}
    (hF : FrobeniusNumber F (gensK k n)) :
    ∃ x ≤ F, x ∉ AddSubmonoid.closure (gensK k n) ∧ F - x ∉ AddSubmonoid.closure (gensK k n) :=
  not_symmetric_of hk (large_cond hn) (fun _ => hn) hF

theorem odd_cond {n : ℕ} (hodd : Odd n) : Even n → False := by
  intro he; exact (Nat.not_even_iff_odd.mpr hodd) he

/-- **Corollary 1.3 for odd `n`**: type two already for odd `n > 2^k`. -/
theorem type_two_odd (hk : 2 ≤ k) (hodd : Odd n) (hn : 2 ^ k < n) :
    Set.ncard {x | IsPF (gensK k n) x} = 2 :=
  type_two_of hk hn (fun he => (odd_cond hodd he).elim)

/-- **Corollary 1.3 for odd `n`**: not symmetric already for odd `n > 2^k`. -/
theorem not_symmetric_odd (hk : 2 ≤ k) (hodd : Odd n) (hn : 2 ^ k < n) {F : ℕ}
    (hF : FrobeniusNumber F (gensK k n)) :
    ∃ x ≤ F, x ∉ AddSubmonoid.closure (gensK k n) ∧ F - x ∉ AddSubmonoid.closure (gensK k n) :=
  not_symmetric_of hk hn (fun he => (odd_cond hodd he).elim) hF

end GenK
