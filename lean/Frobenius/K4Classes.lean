    · positivity
    · exact Nat.Coprime.pow 4 4 (by simp)
    · ring
    · ring
    · ring
    · positivity
    · positivity
    · rw [max_eq_right (show (((2560 * t ^ 2 + 5504 * t + 2960) + (640 * t ^ 2 + 1216 * t + 575)) * ((40 * (t + 1) + 0) + 1) ^ 4 + (280 * t ^ 2 + 564 * t + 283) * ((40 * (t + 1) + 0) + 2) ^ 4) ≤ ((640 * t ^ 2 + 1216 * t + 575) * ((40 * (t + 1) + 0) + 1) ^ 4 + ((2600 * t ^ 2 + 5300 * t + 2701) + (280 * t ^ 2 + 564 * t + 283)) * ((40 * (t + 1) + 0) + 2) ^ 4) from
        calc (((2560 * t ^ 2 + 5504 * t + 2960) + (640 * t ^ 2 + 1216 * t + 575)) * ((40 * (t + 1) + 0) + 1) ^ 4 + (280 * t ^ 2 + 564 * t + 283) * ((40 * (t + 1) + 0) + 2) ^ 4) ≤ (((2560 * t ^ 2 + 5504 * t + 2960) + (640 * t ^ 2 + 1216 * t + 575)) * ((40 * (t + 1) + 0) + 1) ^ 4 + (280 * t ^ 2 + 564 * t + 283) * ((40 * (t + 1) + 0) + 2) ^ 4) + (102400000 * t ^ 6 + 563200000 * t ^ 5 + 1269760000 * t ^ 4 + 1494528000 * t ^ 3 + 961014400 * t ^ 2 + 315884736 * t + 40438336) := Nat.le_add_right _ _
          _ = ((640 * t ^ 2 + 1216 * t + 575) * ((40 * (t + 1) + 0) + 1) ^ 4 + ((2600 * t ^ 2 + 5300 * t + 2701) + (280 * t ^ 2 + 564 * t + 283)) * ((40 * (t + 1) + 0) + 2) ^ 4) := by ring)]
      ring
  · have hmod : (40 * (t + 1) + 0) % 40 = 0 := by omega
    unfold Phi
    rw [hmod]
    unfold phi0
    exact Int.eq_ediv_of_mul_eq_right (by norm_num) (by push_cast; ring)

