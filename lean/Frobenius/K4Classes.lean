/-- Theorem 5.1, residue class `n ≡ 0 (mod 40)`, for `n ≥ 40`. -/
theorem class_0 (t : ℕ) :
    ∃ F : ℕ, FrobeniusNumber F {(40 * (t + 1) + 0) ^ 4, ((40 * (t + 1) + 0) + 1) ^ 4, ((40 * (t + 1) + 0) + 2) ^ 4} ∧ (F : ℤ) = Phi (40 * (t + 1) + 0) := by
  refine ⟨(9011200000 * t ^ 6 + 55808000000 * t ^ 5 + 144020480000 * t ^ 4 + 198232832000 * t ^ 3 + 153487776000 * t ^ 2 + 63386177440 * t + 10907553439), ?_, ?_⟩
